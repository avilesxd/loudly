---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import DownloadCta from '../components/DownloadCta.astro';
import Footer from '../components/Footer.astro';
import { VERSION, REPO, RELEASE, LINKEDIN, YEAR } from '../config/site';
---

<Layout title="Loudly — Masterización de audio profesional">

  <Nav repo={REPO} release={RELEASE} />

  <main>

    <Hero repo={REPO} release={RELEASE} version={VERSION} />

    <Features />

    <HowItWorks />

    <DownloadCta release={RELEASE} version={VERSION} />

  </main>

  <Footer repo={REPO} release={RELEASE} linkedin={LINKEDIN} year={YEAR} />

</Layout>
