---
interface Props {
  repo: string;
  release: string;
  linkedin: string;
  year: number;
}

const { repo, release, linkedin, year } = Astro.props;
---

<footer>
  <div class="container footer-body">

    <div class="footer-brand">
      <a href="/loudly/" class="logo">
        <img
          src="/loudly/favicon.ico"
          alt="Logo de la aplicación Loudly"
          style="border-radius: 15px; width:30px; height:30px;"
        />
        Loudly
      </a>
      <p class="footer-desc">
        Masterización de audio profesional, gratuita y de código abierto.
      </p>
      <div class="footer-socials">
        <a href={repo} target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.341-3.369-1.341-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
          </svg>
        </a>
        <a href={linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="footer-col">
      <h4>Navegación</h4>
      <ul>
        <li><a href="#features">Características</a></li>
        <li><a href="#how">Cómo funciona</a></li>
        <li><a href={release} target="_blank" rel="noopener">Descargar</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Proyecto</h4>
      <ul>
        <li><a href={repo} target="_blank" rel="noopener">GitHub</a></li>
        <li><a href={`${repo}/releases`} target="_blank" rel="noopener">Releases</a></li>
        <li><a href={`${repo}/issues`} target="_blank" rel="noopener">Reportar bug</a></li>
      </ul>
    </div>

  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span>
        © {year}
        <a href={linkedin} target="_blank" rel="noopener" class="footer-author">Ignacio Avilés</a>
        · MIT License
      </span>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .footer-body {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    padding: 3rem 1.5rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 280px;
  }

  .footer-socials {
    display: flex;
    gap: 0.6rem;
  }

  .footer-socials a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-muted);
    transition: color 0.18s, border-color 0.18s;
  }

  .footer-socials a:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .footer-col h4 {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-col ul a {
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: color 0.18s;
  }

  .footer-col ul a:hover { color: var(--text); }

  .footer-bottom {
    border-top: 1px solid var(--border);
    padding: 1.25rem 0;
  }

  .footer-bottom-inner {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .footer-author {
    color: var(--text);
    transition: color 0.18s;
  }

  .footer-author:hover { color: var(--accent); }

  @media (max-width: 640px) {
    .footer-body {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2rem 1.5rem;
    }
  }
</style>
